---
import soundhealingSrc from '../images/fondoSoundhealing.webp';
import reikiSrc from '../images/fondoReiki.webp';
import encuentrosSrc from '../images/magaEncuentros.webp';
---

<div class="services">
  <section id="sesiones" class="sessions" aria-labelledby="sessions-title">
    <div class="sessions__inner">
      <div class="sessions__header">
        <h2 id="sessions-title" class="sessions__title display-title" data-animate="sessions-title">
          Dos maneras de volver a vos
        </h2>
      </div>
    </div>
  </section>

  <article id="soundhealing" class="sound" aria-labelledby="soundhealing-title">
    <img
      class="sound__img"
      data-animate="sound-img"
      src={soundhealingSrc.src}
      alt="Sesión de soundhealing vista desde arriba: persona recostada en esterilla rodeada de cuencos tibetanos junto a la terapeuta"
      width={soundhealingSrc.width}
      height={soundhealingSrc.height}
      loading="lazy"
      decoding="async"
    />
    <div class="sound__body" data-animate="sound-body">
      <h3 id="soundhealing-title" class="sound__name">Soundhealing — con vibroacústica</h3>
      <p class="sound__desc">
        Recostate, cerrá los ojos y dejá que el ruido exterior se apague. Sobre un mat o almohada
        que vibra en sintonía con tu cuerpo, te envuelve un baño sonoro de cuencos, samafones y
        semillas somáticas. Una hora para soltar la mente y habitar tu cuerpo en paz.
      </p>
      <p class="sound__meta" aria-label="Duración y modalidad">
        <span>60 min</span><span aria-hidden="true"> · </span><span>Sesión individual</span>
      </p>
    </div>
  </article>

  <article id="reiki" class="reki" aria-labelledby="reiki-title">
    <img
      class="reki__img"
      data-animate="reki-img"
      src={reikiSrc.src}
      alt="Sesión de Reiki: imposición de manos"
      width={reikiSrc.width}
      height={reikiSrc.height}
      loading="lazy"
      decoding="async"
    />
    <div class="reki__body" data-animate="reki-body">
      <h3 id="reiki-title" class="reki__name">Reiki</h3>
      <p class="reki__desc">
        Hacé una pausa y dejá que tu cuerpo descanse en un espacio de cuidado absoluto. Con
        imposición de manos y símbolos sagrados, la energía vital disuelve tensiones y restaura tu
        equilibrio. Un momento sagrado de calma para acompañar tus procesos con respeto y calidez.
      </p>
      <p class="reki__meta" aria-label="Duración y modalidad">
        <span>60 min</span><span aria-hidden="true"> · </span><span>Sesión individual</span>
      </p>
    </div>
  </article>

  <article id="encuentros" class="gather" aria-labelledby="encuentros-title">
    <img
      class="gather__img"
      data-animate="gather-img"
      src={encuentrosSrc.src}
      alt=""
      aria-hidden="true"
      width={encuentrosSrc.width}
      height={encuentrosSrc.height}
      loading="lazy"
      decoding="async"
    />
    <div class="gather__overlay" aria-hidden="true"></div>
    <div class="gather__body" data-animate="gather-body">
      <p class="gather__kicker kicker">También en ronda</p>
      <h3 id="encuentros-title" class="gather__name">Encuentros grupales</h3>
      <p class="gather__desc">
        Un pequeño concierto compartido. La misma escucha profunda, en ronda y con contención. Ideal
        si querés venir con alguien o probar por primera vez.
      </p>
      <a
        href="#contacto"
        class="sessions__cta gather__cta"
        data-animate="sessions-cta"
        data-spotlight
      >
        <span>Coordinamos un encuentro?</span>
      </a>
    </div>
  </article>
</div>
