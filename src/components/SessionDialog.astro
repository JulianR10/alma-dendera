---
interface Props {
  dialogId: string;
  titleId: string;
  title: string;
  eyebrow: string;
}

const { dialogId, titleId, title, eyebrow } = Astro.props;
---

<dialog id={dialogId} class="session-dialog" aria-labelledby={titleId} closedby="any">
  <div class="session-dialog__inner" data-lenis-prevent>
    <div class="session-dialog__head">
      <div>
        <p class="session-dialog__eyebrow">{eyebrow}</p>
        <h3 id={titleId} class="session-dialog__title text-balance">{title}</h3>
      </div>
      <button
        type="button"
        class="session-dialog__close"
        data-dialog-close
        aria-label="Cerrar ventana"
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="session-dialog__body">
      <slot />
    </div>
    <div class="session-dialog__foot">
      <button type="button" class="session-dialog__close-text" data-dialog-close> Cerrar </button>
    </div>
  </div>
</dialog>
