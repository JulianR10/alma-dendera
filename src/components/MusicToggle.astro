---
import soundSrc from '../images/sound.webp';
---

<button
  id="music-toggle"
  class="music-toggle is-muted"
  type="button"
  aria-label="Reproducir sonido"
  aria-pressed="false"
>
  <img
    src={soundSrc.src}
    alt=""
    aria-hidden="true"
    width={soundSrc.width}
    height={soundSrc.height}
    loading="lazy"
    decoding="async"
  />
</button>
