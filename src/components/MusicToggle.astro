---
import { Image } from 'astro:assets';
import soundSrc from '../images/sound.webp';
---

<button
  id="music-toggle"
  class="music-toggle is-muted"
  type="button"
  aria-label="Reproducir sonido"
  aria-pressed="false"
>
  <Image
    src={soundSrc}
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    widths={[48]}
    sizes="24px"
  />
</button>
