---
import { Image } from 'astro:assets';
import Incense from './Incense.astro';
import instrumentosSrc from '../images/instrumentos.webp';

interface Props {
  imageSrc?: string;
  imageAlt?: string;
}

const { imageSrc, imageAlt = '' } = Astro.props;
---

<section class="quote-band" aria-label="Frase de Maga">
  {
    imageSrc && (
      <img class="quote-band__bg" src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
    )
  }
  <div class="quote-band__overlay" aria-hidden="true"></div>
  <blockquote class="quote-band__quote" data-animate="quote-band">
    <p class="quote-band__text text-balance">
      <span class="quote-band__line">Te invito a sentir la pureza</span>
      <span class="quote-band__line">de habitar tu propio silencio.</span>
    </p>
    <footer class="quote-band__author kicker">— Maga</footer>
  </blockquote>
  <div
    class="quote-band__still"
    style={`aspect-ratio: ${instrumentosSrc.width} / ${instrumentosSrc.height}`}
    aria-hidden="true"
  >
    <Image
      class="quote-band__still-img"
      src={instrumentosSrc}
      alt=""
      loading="lazy"
      decoding="async"
      widths={[400, 800, 1200]}
      sizes="(max-width: 768px) 100vw, 260px"
    />
    <Incense />
  </div>
</section>
