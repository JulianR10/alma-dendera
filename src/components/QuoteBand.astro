---
import Incense from './Incense.astro';
import instrumentosSrc from '../images/instrumentos.webp';

interface Props {
  imageSrc?: string;
  imageAlt?: string;
}

const { imageSrc, imageAlt = '' } = Astro.props;
---

<section class="quote-band" aria-label="Frase de Magalí">
  {
    imageSrc && (
      <img class="quote-band__bg" src={imageSrc} alt={imageAlt} loading="lazy" decoding="async" />
    )
  }
  <div class="quote-band__overlay" aria-hidden="true"></div>
  <blockquote class="quote-band__quote" data-animate="quote-band">
    <p class="quote-band__text">
      <span class="quote-band__line">Detenerse también es un camino:</span>
      <span class="quote-band__line">ahí, el cuerpo vuelve a hablar.</span>
    </p>
    <footer class="quote-band__author kicker">— Magalí</footer>
  </blockquote>
  <div
    class="quote-band__still"
    style={`aspect-ratio: ${instrumentosSrc.width} / ${instrumentosSrc.height}`}
    aria-hidden="true"
  >
    <img
      class="quote-band__still-img"
      src={instrumentosSrc.src}
      alt=""
      width={instrumentosSrc.width}
      height={instrumentosSrc.height}
      loading="lazy"
      decoding="async"
    />
    <Incense />
  </div>
</section>
