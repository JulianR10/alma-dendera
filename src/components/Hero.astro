---
import { Image, getImage } from 'astro:assets';
import MusicToggle from './MusicToggle.astro';
import ResonanceColumn from './ResonanceColumn.astro';
import logoSrc from '../images/logo.webp';
import fondoSrc from '../images/magaMobile.webp';
import fondoDesktopSrc from '../images/magaEscritorio.webp';
import MorphIcon from 'morphicons/astro';
import { Menu } from 'lucide';
import { NAV_LINKS } from '../lib/navigation';
import { SITE } from '../lib/site';

// El hero es la imagen principal: calidad alta para no recomprimir de más una foto ya comprimida.
const HERO_QUALITY = 90;

const fondoDesktop = await getImage({
  src: fondoDesktopSrc,
  widths: [640, 1280, fondoDesktopSrc.width],
  sizes: '100vw',
  quality: HERO_QUALITY,
});
---

<section id="hero" class="hero" aria-label="Inicio">
  <div class="hero__maga-wrap" aria-hidden="true">
    <picture>
      <source
        media="(min-width: 769px)"
        srcset={fondoDesktop.srcSet.attribute}
        sizes="100vw"
        type="image/webp"
      />
      <Image
        src={fondoSrc}
        alt=""
        aria-hidden="true"
        class="hero__maga"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        data-animate="hero-maga"
        widths={[640, 960, 1280, fondoSrc.width]}
        sizes="100vw"
        quality={HERO_QUALITY}
      />
    </picture>
  </div>
  <div class="hero__gradient" aria-hidden="true"></div>
  <nav class="hero__nav" aria-label="Principal">
    <h1 class="hero__logo-wrap" data-animate="hero-logo">
      <a href="#hero" class="hero__nav-logo">
        <Image
          src={logoSrc}
          alt="Alma Dendera"
          class="hero__logo"
          loading="eager"
          decoding="async"
          widths={[120, 240]}
          sizes="(max-width: 768px) 92px, 104px"
        />
        <span class="visually-hidden">— Sound Healing y Reiki Usui en {SITE.city}</span>
      </a>
    </h1>
    <ResonanceColumn />
    <MusicToggle />
  </nav>

  <button
    id="menu-toggle"
    type="button"
    class="hero__menu-toggle"
    aria-label="Abrir menú"
    aria-expanded="false"
  >
    <MorphIcon icon={Menu} />
  </button>

  <div class="hero__center">
    <p class="hero__tagline text-balance" data-animate="hero-phrase">
      Un&nbsp;<span class="hero__breath" data-animate="hero-breath">respiro</span>
      para volver a vos, habitar tu cuerpo y serenar la mente.
    </p>

    <p class="hero__eyebrow kicker" data-animate="hero-eyebrow">
      <span class="hero__eyebrow-pair"
        ><span class="hero__eyebrow-dot" aria-hidden="true">·</span><span class="hero__eyebrow-item"
          >Sound Healing</span
        ></span
      >
      <span class="hero__eyebrow-pair"
        ><span class="hero__eyebrow-dot" aria-hidden="true">·</span><span class="hero__eyebrow-item"
          >Reiki</span
        ></span
      >
    </p>

    <a href="#sesiones" class="hero__cta cta cta--solid" data-animate="hero-cta" data-spotlight
      ><span>¡Me gustaría conocer más!</span></a
    >
  </div>

  <audio
    id="bg-music"
    src={`${import.meta.env.BASE_URL}audio/ambiente.mp3`}
    preload="none"
    loop
    playsinline
    aria-hidden="true"></audio>

  <div class="hero__mobile-menu" id="mobile-menu">
    <nav aria-label="Menú de navegación">
      <ol class="hero__mobile-list">
        {
          NAV_LINKS.map((link, index) => (
            <li class={`hero__mobile-item${index === 0 ? ' is-active' : ''}`}>
              <a href={link.href} class="hero__mobile-link">
                <span class="hero__mobile-dot" aria-hidden="true" />
                <span class="hero__mobile-label">{link.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</section>
