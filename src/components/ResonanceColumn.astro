---
import { SECTION_WAYPOINTS } from '../lib/navigation';
---

<nav class="resonance resonance--nav is-light" aria-label="Progreso de secciones">
  <div class="resonance__glass" aria-hidden="true"></div>
  <ol class="resonance__list">
    {
      SECTION_WAYPOINTS.map((link, index) => (
        <li class={`resonance__item${index === 0 ? ' is-active' : ''}`}>
          <a
            href={link.href}
            class="resonance__link"
            aria-label={`Ir a ${link.label}`}
            aria-current={index === 0 ? 'true' : undefined}
          >
            <span class="resonance__dot" aria-hidden="true" />
            <span class="resonance__label">{link.label}</span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
